# NOTIFICATION SYSTEM - ENVIRONMENT VARIABLES

# ===================================
# COMPANY INFORMATION
# ===================================
COMPANY_NAME="Your Store"
FRONTEND_URL=http://localhost:3000
SUPPORT_EMAIL=support@yourstore.com
SUPPORT_PHONE=+91-XXXXXXXXXX

# ===================================
# EMAIL CONFIGURATION
# ===================================

# Option 1: Gmail (Recommended for testing)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Option 2: SendGrid (Recommended for production)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourstore.com

# Option 3: Custom SMTP
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@domain.com
# EMAIL_PASSWORD=your-password
# EMAIL_FROM=noreply@yourstore.com

# ===================================
# SMS CONFIGURATION (Twilio)
# ===================================
# Sign up at https://www.twilio.com
# Get your credentials from Twilio Console

# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ===================================
# WHATSAPP CONFIGURATION (Twilio)
# ===================================
# Use Twilio WhatsApp sandbox for testing
# For production, apply for WhatsApp Business API access

# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===================================
# PUSH NOTIFICATIONS (Firebase)
# ===================================
# Create a Firebase project at https://console.firebase.google.com
# Go to Project Settings > Service Accounts > Generate New Private Key
# Extract these values from the downloaded JSON file

# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# ===================================
# NOTES
# ===================================

# Gmail Setup:
# 1. Enable 2FA on your Google account
# 2. Generate App Password: Account > Security > 2-Step Verification > App Passwords
# 3. Use the generated password in EMAIL_PASSWORD

# Twilio Setup:
# 1. Sign up and verify your account
# 2. Get a phone number for SMS
# 3. Enable WhatsApp in Twilio console for WhatsApp notifications

# Firebase Setup:
# 1. Create Firebase project
# 2. Add web app to project
# 3. Generate service account key
# 4. Add Firebase SDK to frontend for device token generation

# Leave commented out if you don't want to use a particular channel
# The system will log placeholder messages instead of sending actual notifications
