import express from 'express';
import {
  createOrder,
  getMyOrders,
  getOrderById,
  cancelOrder,
  modifyOrder,
  getAllOrders,
  updateOrderStatus,
  batchUpdateOrderStatus,
  getDashboardAnalytics,
  getOrderAnalyticsByRange,
  searchMyOrders,
  advancedOrderSearch,
  exportOrdersToCSV,
  exportOrdersToExcel
} from '../controllers/orderController.js';
import {
  getOrderTimeline,
  getOrderMilestones,
  addOrderNote,
  getOrderActivityLogs,
  getCriticalActivities,
  exportTimelinePDF,
  getTimelineSummary
} from '../controllers/orderTimelineController.js';
import { protect } from '../middleware/auth.js';
import { isAdmin } from '../middleware/roleCheck.js';
import { validate } from '../middleware/validate.js';
import orderValidator from '../validators/orderValidator.js';

const router = express.Router();

// User routes - Order Management
router.post('/', protect, validate(orderValidator.create, 'body'), createOrder);
router.get('/', protect, validate(orderValidator.getOrders, 'query'), getMyOrders);
router.get('/search', protect, searchMyOrders); // Advanced search for users
router.get('/:id', protect, validate(orderValidator.id, 'params'), getOrderById);
router.post('/:id/cancel', protect, validate(orderValidator.id, 'params'), validate(orderValidator.cancel, 'body'), cancelOrder);
router.put('/:id/modify', protect, validate(orderValidator.id, 'params'), validate(orderValidator.modify, 'body'), modifyOrder);

// Timeline routes - User & Admin
router.get('/:id/timeline', protect, validate(orderValidator.id, 'params'), getOrderTimeline);
router.get('/:id/timeline/milestones', protect, validate(orderValidator.id, 'params'), getOrderMilestones);
router.post('/:id/timeline/note', protect, validate(orderValidator.id, 'params'), addOrderNote);
router.get('/:id/timeline/export/pdf', protect, validate(orderValidator.id, 'params'), exportTimelinePDF);
router.get('/timeline/summary', protect, getTimelineSummary);

// Admin routes - Order Management
router.get('/admin/orders', protect, isAdmin, validate(orderValidator.getAllOrders, 'query'), getAllOrders);
router.get('/admin/search', protect, isAdmin, advancedOrderSearch); // Advanced search for admin
router.put('/admin/orders/:id/status', protect, isAdmin, validate(orderValidator.id, 'params'), validate(orderValidator.updateStatus, 'body'), updateOrderStatus);

// Export routes (Admin)
router.get('/admin/export/csv', protect, isAdmin, exportOrdersToCSV);
router.get('/admin/export/excel', protect, isAdmin, exportOrdersToExcel);

// Admin routes - Activity Logs
router.get('/:id/activity-logs', protect, isAdmin, validate(orderValidator.id, 'params'), getOrderActivityLogs);
router.get('/activity-logs/critical', protect, isAdmin, getCriticalActivities);

// Batch operations (Admin)
router.put('/admin/orders/batch/status', protect, isAdmin, batchUpdateOrderStatus);

// Analytics routes (Admin)
router.get('/admin/analytics/dashboard', protect, isAdmin, getDashboardAnalytics);
router.get('/admin/analytics/range', protect, isAdmin, getOrderAnalyticsByRange);

export default router;
